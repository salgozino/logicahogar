---
const stack = [
  {
    label: "El cerebro del sistema",
    tech: "Vive en tu casa, no en la nube",
    description: "El sistema corre en hardware dedicado dentro de tu red. Tus datos no salen nunca a servidores externos ni dependen de que una empresa siga operando.",
    icon: "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
  },
  {
    label: "La red de dispositivos",
    tech: "No satura tu Wi-Fi",
    description: "Usamos una red inalámbrica separada, diseñada para el hogar inteligente. Más estable que Wi-Fi, sin interferencias y funciona aunque el router falle.",
    icon: "M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.858 15.355-5.858 21.213 0",
  },
  {
    label: "Los dispositivos",
    tech: "Lo mejor para cada caso",
    description: "Seleccionamos los actuadores y sensores según la necesidad real. Priorizamos confiabilidad y precio razonable, sin atarte a una sola marca.",
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
  },
  {
    label: "El control",
    tech: "Desde donde quieras",
    description: "Paneles personalizados en el celular o tablet. Control por voz completamente local: nadie escucha tus conversaciones desde la nube.",
    icon: "M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z",
  },
];
---

<section id="tecnologia" class="py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div class="text-center">
      <h2 class="text-3xl font-bold text-primary-900 sm:text-4xl">
        La tecnología detrás de tu hogar
      </h2>
      <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">
        Usamos tecnología abierta y probada. Sin suscripciones mensuales, sin dependencia de una sola marca.
      </p>
    </div>

    <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {stack.map((item) => (
        <div class="group rounded-xl border border-gray-200 p-6 hover:border-primary-300 hover:shadow-md focus-within:ring-2 focus-within:ring-primary-300 transition-all">
          <div class="flex h-14 w-14 items-center justify-center rounded-full bg-primary-50 group-hover:bg-primary-100 transition-colors">
            <svg class="h-7 w-7 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={item.icon} />
            </svg>
          </div>
          <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-accent-600">{item.label}</p>
          <h3 class="mt-1 text-lg font-bold text-primary-900">{item.tech}</h3>
          <p class="mt-2 text-sm text-gray-600 leading-relaxed">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
