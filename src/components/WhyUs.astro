---
const pillars = [
  {
    title: "Privacidad Total",
    description:
      "Los datos de tu casa no salen a servidores externos. Todo se procesa localmente, en tu propia red.",
    icon: "M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z",
  },
  {
    title: "Autonomía",
    description:
      "El sistema funciona al 100% sin Internet. Las teclas siguen funcionando siempre, la usabilidad se prioriza sobre la automatización.",
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
  },
  {
    title: "Escalabilidad",
    description:
      "Sistema abierto basado en estándares. Sin encierro con una sola marca. Agregá dispositivos cuando quieras, de la marca que prefieras.",
    icon: "M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4",
  },
  {
    title: "Asesoría Experta",
    description:
      "No vendemos productos. Diseñamos el ecosistema que mejor se adapta a tu vida y tu presupuesto.",
    icon: "M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z",
  },
];
---

<section id="por-que-nosotros" class="py-24 bg-primary-950">
  <div class="mx-auto max-w-7xl px-6">
    <div class="text-center">
      <h2 class="text-3xl font-bold text-white sm:text-4xl">
        ¿Por qué LógicaHogar?
      </h2>
      <p class="mt-4 text-lg text-primary-300 max-w-2xl mx-auto">
        Cuatro pilares que nos diferencian de cualquier solución comercial estándar.
      </p>
    </div>

    <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {pillars.map((pillar) => (
        <div class="text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-primary-800 border border-primary-700">
            <svg class="h-8 w-8 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={pillar.icon} />
            </svg>
          </div>
          <h3 class="mt-6 text-lg font-semibold text-white">{pillar.title}</h3>
          <p class="mt-3 text-sm text-primary-300 leading-relaxed">{pillar.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
