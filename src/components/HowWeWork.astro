---
const steps = [
  {
    number: "01",
    title: "Consulta inicial",
    description: "Contanos qué tenés en mente, sin compromiso. En una charla de 30 minutos entendemos tu casa, tus necesidades y tu presupuesto.",
    icon: "M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z",
  },
  {
    number: "02",
    title: "Diseño del proyecto",
    description: "Diseñamos el sistema a medida de tu casa y tu presupuesto. Te presentamos un plan claro: qué se instala, cómo funciona y cuánto cuesta.",
    icon: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
  },
  {
    number: "03",
    title: "Instalación",
    description: "Nuestro equipo instala los dispositivos sin obras pesadas ni sorpresas. En la mayoría de los casos, terminamos en un día.",
    icon: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z",
  },
  {
    number: "04",
    title: "Soporte post-instalación",
    description: "Te acompañamos una vez que el sistema está en marcha. Ajustes, dudas o expansiones futuras: seguimos disponibles.",
    icon: "M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z",
  },
];
---

<section id="como-trabajamos" class="py-24 bg-gray-50">
  <div class="mx-auto max-w-7xl px-6">
    <div class="text-center">
      <h2 class="text-3xl font-bold text-primary-900 sm:text-4xl">
        ¿Cómo trabajamos?
      </h2>
      <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">
        Del primer contacto a la casa funcionando. Un proceso claro, sin sorpresas.
      </p>
    </div>

    <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, index) => (
        <div class="relative">
          {/* Connector line between steps (desktop) */}
          {index < steps.length - 1 && (
            <div class="hidden lg:block absolute top-8 left-full w-full h-px bg-gray-200 -translate-x-8 z-0" />
          )}
          <div class="relative z-10 flex flex-col items-center text-center">
            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-primary-700 text-white shadow-md">
              <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={step.icon} />
              </svg>
            </div>
            <p class="mt-4 text-xs font-bold tracking-widest text-accent-500">{step.number}</p>
            <h3 class="mt-1 text-lg font-semibold text-primary-900">{step.title}</h3>
            <p class="mt-2 text-sm text-gray-600 leading-relaxed">{step.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
